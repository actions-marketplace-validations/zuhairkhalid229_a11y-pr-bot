# ---- GitHub App ----------------------------------------------------------
# Settings -> Developer settings -> GitHub Apps -> your app
GITHUB_APP_ID=123456
# Webhook secret you set on the app (openssl rand -hex 32)
GITHUB_WEBHOOK_SECRET=replace-me
# The downloaded .pem. Either paste the PEM with literal \n escapes, or
# base64 the whole file:  base64 -w0 your-app.private-key.pem
GITHUB_PRIVATE_KEY=

# ---- Google Cloud --------------------------------------------------------
GCP_PROJECT_ID=your-project-id
FIRESTORE_DATABASE=(default)
# Local dev: gcloud emulators firestore start --host-port=localhost:8081
# FIRESTORE_EMULATOR_HOST=localhost:8081

# ---- Cloud Tasks ---------------------------------------------------------
# false locally (no emulator exists) -> payloads are logged instead of queued
ENABLE_CLOUD_TASKS=false
TASKS_LOCATION=europe-west1
TASKS_QUEUE=a11y-scans
# Cloud Run URL of the scanner worker; /tasks/scan and /tasks/fallback are appended
WORKER_BASE_URL=https://a11y-worker-xxxxxxxx.europe-west1.run.app
# Minutes to wait for a preview deployment before marking the scan no_preview
PREVIEW_WAIT_MINUTES=15
# Service account Cloud Tasks mints an OIDC token as
TASKS_INVOKER_SA=tasks-invoker@your-project-id.iam.gserviceaccount.com

# ---- App -----------------------------------------------------------------
# Fernet key for per-repo secrets (Vercel bypass token). Generate once:
#   python -c "from app.crypto import SecretBox; print(SecretBox.generate_key())"
APP_ENCRYPTION_KEY=
CHECK_RUN_NAME=Accessibility (WCAG 2.2 AA)
DEDUPE_TTL_DAYS=7
LOG_LEVEL=INFO
# Browser origins allowed to call /api (the dashboard), comma separated
DASHBOARD_ORIGINS=http://localhost:3000,https://a11y.yourdomain.com

# ---- Gemini (worker) -----------------------------------------------------
# AI Studio key. Leave empty to disable source mapping (scans still run).
GEMINI_API_KEY=
# Measured 2026-09-29 on the 12-case eval: 0 wrong suggestions, 100% location
# precision, 91% recall. gemini-3.5-flash is capped at 20 requests/day on the
# free tier, which one scan can exhaust; re-measure it on a paid tier before
# switching. Never switch models without re-running scripts/eval_mapper.py.
GEMINI_MODEL=gemini-3.1-flash-lite
# Findings mapped per scan, worst impact first. Each one is a model call.
MAPPER_MAX_FINDINGS=10
